# Copy to .env and supply your RPC/explorer credentials. Never commit .env.
# Sign with a hardware wallet or Foundry keystore; do not add a private key here.
MAINNET_RPC_URL=
ETHERSCAN_API_KEY=

# Optional deployment overrides. The scripts contain project-specific defaults;
# set these for your deployment, and use the same factory-owner address as --sender.
# PLAYGROUND_FACTORY_OWNER=YOUR_ADMIN_ADDRESS
# PLAYGROUND_TOKENWORKS=YOUR_REVENUE_RECIPIENT_ADDRESS
# PLAYGROUND_INTAKE=YOUR_COMPATIBLE_INTAKE_ADDRESS

# The included frozen Ethereum snapshot is used on both chains.
PLAYGROUND_S02_SNAPSHOT=output/playground/s02-snapshot.json
